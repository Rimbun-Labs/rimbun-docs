            "name": "limit",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "Successful response"
          }
        },
        "summary": "Get banking product recommendations for a partner customer",
        "tags": [
          "Partner Recommendations"
        ],
        "x-audience": [
          "partner"
        ],
        "description": "Partner API. Authenticates with `Authorization: Bearer <api_key>`. `customerId` is the partner's customer identifier (same as `providerAccountId` in ingestion). Tenant scope is resolved from the API key.",
        "security": [
          {
            "bearerApiKey": []
          }
        ]
