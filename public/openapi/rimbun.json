          },
          "premiumMonthly": {
            "minimum": 0,
            "type": "number"
          },
          "cashValue": {
            "minimum": 0,
            "type": "number"
          },
          "startDate": {
            "pattern": "\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d.\\d+Z?",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AddExistingInsuranceProductRequest": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "sumAssured": {
            "minimum": 0,
            "type": "number"
          },
          "premiumMonthly": {
            "minimum": 0,
            "type": "number"
          },
          "cashValue": {
            "minimum": 0,
            "type": "number"
          },
          "startDate": {
            "pattern": "\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d.\\d+Z?",
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "productId"
        ]
      },
      "UpdateExistingProductRequest": {
        "properties": {
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "currentBalance": {
            "minimum": 0,
            "type": "number"
          },
          "outstandingBalance": {
            "minimum": 0,
            "type": "number"
          },
          "creditLimit": {
            "minimum": 0,
            "type": "number"
          },
          "loanAmount": {
            "minimum": 0,
            "type": "number"
          },
          "monthlyPayment": {
            "minimum": 0,
            "type": "number"
          },
          "lastUsedDate": {
            "pattern": "\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d.\\d+Z?",
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "productId"
        ]
      },
      "AddExistingProductRequest": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ExistingProductInput"
          }
        },
        "type": "object",
        "required": [
          "product"
        ]
      },
      "ExistingProductInput": {
        "properties": {
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "currentBalance": {
            "minimum": 0,
            "type": "number"
          },
          "outstandingBalance": {
            "minimum": 0,
            "type": "number"
          },
          "creditLimit": {
            "minimum": 0,
            "type": "number"
          },
          "loanAmount": {
            "minimum": 0,
            "type": "number"
          },
          "monthlyPayment": {
            "minimum": 0,
            "type": "number"
          },
