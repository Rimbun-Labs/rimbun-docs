        },
        "type": "object",
        "required": [
          "productId"
        ]
      },
      "PartnerSubmitStatementRequestDto": {
        "properties": {
          "externalCustomerId": {
            "type": "string"
          },
          "statementId": {
            "type": "string"
          },
          "bankStatement": {
            "$ref": "#/components/schemas/BankStatementResponseDtoIngest"
          }
        },
        "type": "object",
        "required": [
          "externalCustomerId",
          "statementId",
          "bankStatement"
        ]
      },
      "BankStatementResponseDtoIngest": {
        "properties": {
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/BankStatementTransactionDtoIngest"
            },
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/BankStatementSummaryDtoIngest"
          },
          "accountIdentifier": {
            "type": "object"
          },
          "fees": {
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "transactions"
        ]
      },
      "BankStatementSummaryDtoIngest": {
        "properties": {
          "periodStart": {
            "type": "string"
          },
          "periodEnd": {
            "type": "string"
          },
          "openingBalance": {
            "type": "number"
          },
          "closingBalance": {
            "type": "number"
          },
          "totalCredits": {
            "type": "number"
          },
          "totalDebits": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BankStatementTransactionDtoIngest": {
        "properties": {
          "date": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "credit",
              "debit"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred",
              "not_disclosed"
            ]
          }
        },
        "type": "object",
        "required": [
          "date",
          "description",
          "amount",
          "type"
        ]
      }
    },
    "securitySchemes": {
      "bearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Partner API key sent as `Authorization: Bearer <api_key>`."
      }
    }
  },
  "info": {
    "title": "Rimbun Partner API",
    "version": "1.0.0",
    "description": "Programmatic contract for financial institutions integrating Rimbun: ingest transactions, read explainable recommendations, and report outcomes."
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/partners/ingestion/statements": {
      "post": {
        "operationId": "PartnerIngestionController.submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerSubmitStatementRequestDto"
              }
            }
          },
          "description": "PartnerSubmitStatementRequestDto",
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jobId",
                    "status",
                    "idempotent"
                  ],
                  "properties": {
                    "jobId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued"
                      ]
                    },
                    "idempotent": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "description": "Accepted"
          }
        },
        "summary": "Enqueue async ingestion for a canonical bank statement (partner HMAC)",
        "tags": [
          "Partner Ingestion"
        ],
        "x-audience": [
          "partner"
        ],
        "description": "Authenticates via HMAC headers documented in docs/guides/partners/PARTNER_INGESTION_SIGNING.md. Returns 202 with a job id; processing happens asynchronously.",
        "security": []
      }
    },
    "/api/v1/partners/ingestion/jobs/{jobId}": {
      "get": {
        "operationId": "PartnerIngestionController.getJob",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "pattern": "[^\\/#\\?]+?",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "succeeded",
                        "failed",
                        "dead"
                      ]
                    },
                    "externalCustomerId": {
                      "type": "string"
                    },
                    "statementId": {
                      "type": "string"
                    },
                    "idempotencyKey": {
                      "type": "string"
                    },
                    "attemptCount": {
                      "type": "integer"
                    },
                    "nextRunAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "finishedAt": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "lastError": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            },
            "description": "Job status"
          }
        },
        "summary": "Poll partner ingestion job status",
        "tags": [
          "Partner Ingestion"
        ],
        "x-audience": [
          "partner"
        ],
        "security": []
      }
    },
