            "minimum": 0,
            "type": "number"
          },
          "monthlyContribution": {
            "minimum": 0,
            "type": "number"
          },
          "startDate": {
            "pattern": "\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d.\\d+Z?",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AddExistingPositionRequest": {
        "properties": {
          "shareClassId": {
            "type": "string"
          },
          "currentValue": {
            "minimum": 0,
            "type": "number"
          },
          "units": {
            "minimum": 0,
            "type": "number"
          },
          "monthlyContribution": {
            "minimum": 0,
            "type": "number"
          },
          "startDate": {
            "pattern": "\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d.\\d+Z?",
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "shareClassId"
        ]
      },
      "UpdateExistingInsuranceProductRequest": {
        "properties": {
          "sumAssured": {
            "minimum": 0,
